  "policies": {
    "NO_PROFILE": {
      "action": "note",
      "message": "No crop profile for this field: the analysis uses crop-neutral defaults."
    },
    "PROFILE_EXPERIMENTAL": {
      "action": "note",
      "message": "Corn profile is experimental: its row, cover and position rules are benchmarked on rendered stands, three photos and one public field, not yet on your fields."
    },
    "UNKNOWN_RESOLUTION": {
      "action": "disable",
      "message": "The pixel size is not known, so no spacing, size or area is stated."
    },
    "INSUFFICIENT_RESOLUTION": {
      "action": "disable",
      "message": "The imagery is too coarse for this in corn; the limit and the reason are named per analysis."
    },
    "UNKNOWN_STAGE": {
      "action": "note",
      "message": "No planting date: closure, the critical period and the expected cover are not checked."
    },
    "STAGE_ESTIMATED": {
      "action": "note",
      "message": "Stage estimated from the planting date (calendar), often off by one to three leaves; not observed."
    },
    "UNSUPPORTED_STAGE": {
      "action": "disable",
      "message": "The canopy has closed or is closing at this stage: weed cover between the rows can no longer be measured from above."
    },
    "CANOPY_CLOSED": {
      "action": "disable",
      "message": "Almost all of the ground is under green: between-row cover and weed counts are not measured."
    },
    "ROW_SPACING_UNEXPECTED": {
      "action": "review",
      "message": "The rows read at a spacing corn is not planted at: the reading is kept; check the crop on file or the read."
    },
    "ROWS_UNCERTAIN": {
      "action": "review",
      "message": "The rows are uncertain (heavy weeds, closed canopy, curved rows): position-based weed calls are weaker here."
    },
    "NO_ROWS": {
      "action": "disable",
      "message": "No rows found: nothing is called a weed by position."
    },
    "COVER_STAGE_MISMATCH": {
      "action": "review",
      "message": "The green cover does not fit corn at this stage: the planting date, the stage or heavy weed pressure is off."
    },
    "VEGETATION_MASK_SUSPECT": {
      "action": "note",
      "message": "The automatic green split was separating soil from residue; the corn ExGR gate kept the mask to green plants."
    },
    "WITHIN_ROW_UNRESOLVED": {
      "action": "note",
      "message": "Weeds inside the crop row are not judged: they cannot be told from corn at this resolution."
    },
    "SPECIES_NOT_RESOLVABLE": {
      "action": "note",
      "message": "Species are not identified from the imagery; the list is what is commonly reported in corn here at this time of year."
    },
    "THRESHOLD_PROVISIONAL": {
      "action": "note",
      "message": "Corn pressure classes are provisional: US guidance acts on weed height (before about 10 cm) and stage, not on cover."
    },
    "CAPABILITY_UNSUPPORTED": {
      "action": "disable",
      "message": "Not supported for corn yet; the reason is named."
    }
  },
