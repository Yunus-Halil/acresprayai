  "pressure": {
    "scheme": {
      "low": 0.01,
      "moderate": 0.05,
      "action": 0.1,
      "high": 0.2,
      "source": "Provisional for corn: US guidance acts on weed height (before about 10 cm) and crop stage (first pass by V4; the critical period runs to about V10), not on cover. The classes use the Turkish ministry's maize action point (10% cover, TAGEM 2022) with Peña's 20% as high; read them as relative pressure.",
      "basis": "provisional"
    },
