  "capabilities": {
    "row-detection": {
      "status": "experimental",
      "maxGsdCm": 5,
      "stages": [
        "V2",
        "V9"
      ],
      "reason": "Photo pattern pass with the corn prior; benchmarked on rendered stands and on three real photos (one used to diagnose the residue failure), not on an independent field set with row truth."
    },
    "row-spacing": {
      "status": "experimental",
      "maxGsdCm": 5,
      "stages": [
        "V2",
        "V9"
      ],
      "reason": "Pitch is measured, never assumed; checked against the planted corn spacings."
    },
    "planting-positions": {
      "status": "experimental",
      "maxGsdCm": 1.5,
      "stages": [
        "V2",
        "V4"
      ],
      "reason": "The pattern pass places plants along rows when a consistent seed spacing is found; positions from the pattern are expected, not verified plants. Not benchmarked against plant truth."
    },
    "crop-vs-weed-by-position": {
      "status": "experimental",
      "maxGsdCm": 3,
      "stages": [
        "V1",
        "V9"
      ],
      "reason": "Off-row green is a weed candidate; weeds in the row are not separable. Measured on WeedsGalore (one German maize field) held-out patches."
    },
    "vegetation-segmentation": {
      "status": "experimental",
      "reason": "ExG + CIVE Otsu with the corn ExGR gate; measured on WeedsGalore band composites, which are not a consumer RGB camera."
    },
    "between-row-weed-cover": {
      "status": "experimental",
      "maxGsdCm": 3,
      "stages": [
        "V1",
        "V9"
      ],
      "reason": "Off-row cover against labelled weed cover on WeedsGalore held-out patches; one field."
    },
    "weed-pressure-grade": {
      "status": "unsupported",
      "maxGsdCm": 3,
      "stages": [
        "V1",
        "V9"
      ],
      "reason": "The field-map row reader needs rows at least 1 m apart made of separate plants, and the planting-layout fitter is built for trees; corn rows are read only by the photo pattern pass, which does not yet feed the map grade. Grading corn on the map stays refused until a continuous-row map reader exists and passes its benchmark."
    },
    "hotspots": {
      "status": "unsupported",
      "reason": "The hotspot finder runs on confirmed planting-layout rows, which corn does not have yet (see weed-pressure-grade)."
    },
    "weed-isolation": {
      "status": "experimental",
      "maxGsdCm": 2.5,
      "reason": "Local segmentation around a spot in the original frame; four pixels across the smallest object."
    },
    "weed-measurement": {
      "status": "experimental",
      "maxGsdCm": 1,
      "reason": "The sizer's consistency was checked; its accuracy was never verified against hand-measured plants."
    },
    "species-priors": {
      "status": "supported",
      "reason": "A regional, seasonal reference list from surveys and extension guides; never an identification."
    },
    "stand-count": {
      "status": "unsupported",
      "maxGsdCm": 1.5,
      "stages": [
        "V2",
        "V3"
      ],
      "reason": "Not implemented for corn; the pattern pass's seed fit is not a validated stand count."
    },
    "growth-stage-from-imagery": {
      "status": "unsupported",
      "reason": "No validated method infers corn V stage from RGB cover; the stage comes from the planting date, with its error stated."
    },
    "stage-estimate": {
      "status": "experimental",
      "reason": "Calendar estimate from the planting date: a range of stages, typically off by one to three leaves; no daily weather is read."
    },
    "canopy-height": {
      "status": "unsupported",
      "reason": "No height model is read; photogrammetric height error (4 to 39 cm) is the size of a seedling."
    }
  },
