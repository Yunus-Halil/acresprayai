    },
    "stage1": {
      "mask": "cover"
    },
    "actionSignals": {
      "weedHeightActionCm": 10,
      "firstPassByStage": "V4",
      "notes": "Iowa State: mean yield loss 0% at 2 in weed height, 2% at 4 in, 6% at 6 in, 22% at 12 in (37 experiments); a first post pass before weeds reach 10 cm and no later than V4 (Gower 2003); each leaf stage of delay in the critical period costs about 2%. Label ceilings: V8 or 30 in for most post products. Decision support only: Swardus names zones and areas, never a product or rate."
    }
  },
