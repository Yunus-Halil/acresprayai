              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "year": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "list": {
                  "type": "string",
                  "enum": [
                    "most-common",
                    "most-troublesome"
                  ]
                },
                "respondents": {
                  "type": "string"
                },
                "ranked": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
