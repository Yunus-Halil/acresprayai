                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "strength": {
                      "type": "string",
                      "enum": [
                        "strong",
                        "moderate",
                        "weak",
                        "snippet",
                        "estimate",
                        "none"
