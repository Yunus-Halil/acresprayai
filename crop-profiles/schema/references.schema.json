{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crop profile: references",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "extension",
              "peer-reviewed",
              "government",
              "vendor",
              "dataset",
              "own-measurement",
              "secondary",
              "other"
            ]
          },
          "geography": {
            "type": "string"
          },
          "accessed": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "type"
        ]
      }
    }
  },
  "required": [
    "sources"
  ]
}
