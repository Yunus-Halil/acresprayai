{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crop profile: identity",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "scientificName": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "commonNames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "language"
        ]
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cropGroup": {
      "type": "string",
      "enum": [
        "wide-row",
        "cereal",
        "orchard"
      ]
    },
    "growthHabit": {
      "type": "string",
      "enum": [
        "annual-row-crop",
        "annual-drilled",
        "perennial-tree",
        "perennial-vine",
        "perennial-forage"
      ]
    },
    "productionTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "regionsCovered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "scientificName",
    "family",
    "commonNames",
    "aliases",
    "cropGroup",
    "growthHabit",
    "productionTypes",
    "regionsCovered"
  ]
}
