{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crop profile: algorithms",
  "type": "object",
  "properties": {
    "rowReader": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "continuous-row",
            "separate-plants",
            "drilled",
            "orchard-lattice"
          ]
        },
        "defaultSpacingM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "candidatesM": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "pitchToleranceShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "windowRows": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "maxNeighbourhoodM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vegetationFractionRange": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "verifyBrightnessAgainstVegetation": {
          "type": "boolean"
        },
        "continuousFromStage": {
          "type": "string"
        },
        "bandHalfWidthM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "readGsdCm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "strategy",
        "defaultSpacingM",
        "candidatesM",
        "pitchToleranceShare",
        "windowRows",
        "maxNeighbourhoodM",
        "vegetationFractionRange",
        "verifyBrightnessAgainstVegetation",
        "rationale",
        "sources"
      ]
    },
    "plantingPositions": {
      "type": "object",
      "properties": {
        "alongRangeM": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "typical": {
              "type": "number"
            }
          },
          "required": [
            "low",
            "high"
          ]
        },
        "resolvableStages": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "maxGsdCm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "alongRangeM",
        "maxGsdCm",
        "rationale",
        "sources"
      ]
    },
    "vegetation": {
      "type": "object",
      "properties": {
        "index": {
          "type": "string",
          "enum": [
            "exg-cive-otsu",
            "exgr"
          ]
        },
        "indexFloor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "exgrGate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverExgr": {
          "type": "number"
        },
        "canopyClosedShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expectedCoverByStage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string"
              },
              "range": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "typical": {
                    "type": "number"
                  }
                },
                "required": [
                  "low",
                  "high"
                ]
              }
            },
            "required": [
              "stage",
              "range"
            ]
          }
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "index",
        "indexFloor",
        "exgrGate",
        "coverExgr",
        "canopyClosedShare",
        "expectedCoverByStage",
        "rationale",
        "sources"
      ]
    },
    "pressure": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "wide-row",
            "cereal",
            "orchard"
          ]
        },
        "scheme": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "moderate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "action": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "source": {
              "type": "string"
            },
            "basis": {
              "type": "string",
              "enum": [
                "cover",
                "provisional"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "low",
            "moderate",
            "action",
            "high",
            "source",
            "basis",
            "sources"
          ]
        },
        "applicableStages": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "grade": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "stage1": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "actionSignals": {
          "type": "object",
          "properties": {
            "weedHeightActionCm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "firstPassByStage": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "notes",
            "sources"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "group",
        "scheme",
        "applicableStages",
        "grade",
        "stage1",
        "actionSignals",
        "rationale"
      ]
    },
    "hotspots": {
      "type": "object",
      "properties": {
        "minObjectDiameterM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "minObjectDiameterM",
        "rationale"
      ]
    },
    "sourceFrames": {
      "type": "object",
      "properties": {
        "preferFramesForMeasurement": {
          "type": "boolean"
        },
        "maxGsdCm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "preferFramesForMeasurement",
        "maxGsdCm",
        "rationale"
      ]
    },
    "weedMeasurement": {
      "type": "object",
      "properties": {
        "minPixelsAcross": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sizeThresholdsCm": {
          "type": "object",
          "properties": {
            "small": {
              "type": "number"
            },
            "medium": {
              "type": "number"
            }
          },
          "required": [
            "small",
            "medium"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "minPixelsAcross",
        "sizeThresholdsCm",
        "rationale",
        "sources"
      ]
    },
    "species": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "environmental-priors-only"
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "method",
        "rationale",
        "sources"
      ]
    },
    "consistency": {
      "type": "object",
      "properties": {
        "rowSpacingMismatchShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minRowCoherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverStageToleranceShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "rowSpacingMismatchShare",
        "minRowCoherence",
        "coverStageToleranceShare",
        "rationale"
      ]
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "row-detection",
              "row-spacing",
              "planting-positions",
              "crop-vs-weed-by-position",
              "vegetation-segmentation",
              "between-row-weed-cover",
              "weed-pressure-grade",
              "hotspots",
              "weed-isolation",
              "weed-measurement",
              "species-priors",
              "stand-count",
              "growth-stage-from-imagery",
              "stage-estimate",
              "canopy-height"
            ]
          },
          {
            "not": {}
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "experimental",
              "unsupported"
            ]
          },
          "maxGsdCm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stages": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "validatedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "reason"
        ]
      }
    }
  },
  "required": [
    "rowReader",
    "plantingPositions",
    "vegetation",
    "pressure",
    "hotspots",
    "sourceFrames",
    "weedMeasurement",
    "species",
    "consistency",
    "capabilities"
  ]
}
