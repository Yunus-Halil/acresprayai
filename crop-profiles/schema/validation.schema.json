{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crop profile: validation",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "unvalidated",
        "partial",
        "validated"
      ]
    },
    "summary": {
      "type": "string"
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "capability": {
            "type": "string",
            "enum": [
              "row-detection",
              "row-spacing",
              "planting-positions",
              "crop-vs-weed-by-position",
              "vegetation-segmentation",
              "between-row-weed-cover",
              "weed-pressure-grade",
              "hotspots",
              "weed-isolation",
              "weed-measurement",
              "species-priors",
              "stand-count",
              "growth-stage-from-imagery",
              "stage-estimate",
              "canopy-height"
            ]
          },
          "dataset": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "images": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "gsdCm": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "split": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "codeRevision": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "resultFile": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string"
                },
                "threshold": {
                  "type": "string"
                },
                "met": {
                  "type": "boolean"
                }
              },
              "required": [
                "metric",
                "threshold"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "run",
              "blocked"
            ]
          },
          "notes": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "capability",
          "dataset",
          "images",
          "gsdCm",
          "stages",
          "split",
          "command",
          "acceptance",
          "status"
        ]
      }
    },
    "failureCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "date": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "symptom": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "regressionTest": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "fixed",
              "accepted"
            ]
          }
        },
        "required": [
          "id",
          "date",
          "image",
          "symptom",
          "cause",
          "status"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "summary",
    "benchmarks",
    "failureCases",
    "gaps"
  ]
}
