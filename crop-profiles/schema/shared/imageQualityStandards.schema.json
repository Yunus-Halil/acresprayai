{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared vocabulary: imageQualityStandards",
  "type": "object",
  "properties": {
    "gsdBands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "gsdCm": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "gsdCm",
          "description"
        ]
      }
    },
    "smallestObjectRule": {
      "type": "object",
      "properties": {
        "pixelsAcross": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "statement": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "pixelsAcross",
        "statement",
        "source"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "definition"
        ]
      }
    }
  },
  "required": [
    "gsdBands",
    "smallestObjectRule",
    "checks"
  ]
}
