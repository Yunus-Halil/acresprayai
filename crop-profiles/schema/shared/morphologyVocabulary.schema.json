{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared vocabulary: morphologyVocabulary",
  "type": "object",
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "definition"
        ]
      }
    }
  },
  "required": [
    "terms"
  ]
}
