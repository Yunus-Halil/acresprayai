{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared vocabulary: weedTaxonomy",
  "type": "object",
  "properties": {
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "scientificName": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "commonNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lifeForm": {
            "type": "string",
            "enum": [
              "annual-grass",
              "annual-broadleaf",
              "perennial-grass",
              "perennial-broadleaf",
              "sedge",
              "vine",
              "biennial-broadleaf"
            ]
          },
          "photosynthesis": {
            "type": "string",
            "enum": [
              "C3",
              "C4"
            ]
          },
          "habit": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "scientificName",
          "family",
          "commonNames",
          "lifeForm"
        ]
      }
    }
  },
  "required": [
    "species"
  ]
}
