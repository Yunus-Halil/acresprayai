# Copy to .env and fill in with your own Supabase project values.
# .env itself is gitignored - never commit real project credentials.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-side secrets are NOT set here. They live in Supabase edge function
# secrets (`supabase secrets set ...`):
#   ODM_BASE_URL, ODM_AUTH_TOKEN   - the OpenDroneMap/WebODM processing node
#   AI_API_KEY                     - key for the vision provider (analyze-ortho)
#   AI_GATEWAY_URL                 - optional; any OpenAI-compatible
#                                    /chat/completions endpoint. Defaults to
#                                    Google's OpenAI-compatible endpoint.
#   AI_MODEL                       - optional; defaults to "gemini-2.5-flash".
#                                    Use "google/gemini-2.5-flash" on OpenRouter.
#   OPENWEATHER_API_KEY            - optional; falls back to Open-Meteo
#   ORTHO_EXTRACT_FROM_ZIP         - "true" only on a node with >256MB workers

# Deploying to Vercel: set exactly these three VITE_ vars in Project Settings ->
# Environment Variables, for Production, Preview and Development. They are
# compiled into the JavaScript bundle at build time and are public by design -
# the anon key is meant to be seen, and RLS is what protects the data.
#
# Never put a service-role key, RESEND_API_KEY, ODM_AUTH_TOKEN or AI_API_KEY in
# Vercel. Those are server-side and live in Supabase edge function secrets. A
# VITE_-prefixed secret is not a secret; it ships to every visitor.
