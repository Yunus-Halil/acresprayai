# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment. Copy .env.example and fill in your own project values.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase CLI local state (linked project ref, etc.)
supabase/.temp/

# Raw screen-capture masters. The encoded web derivatives in public/video/ are
# committed; the multi-megabyte sources are not — once a binary that size is in
# the history it is there forever, and nothing served needs it.
# See public/video/README.md for the encode commands.
src/test/videos/

# The onnxruntime-web WebAssembly runtime, copied from node_modules by
# scripts/copy-ort-wasm.cjs before dev and build. Fourteen megabytes npm already ships.
public/ort/

# Benchmark output (scripts/bench): crops cut from kept originals, records,
# pages. Imagery from real fields; never committed.
data/

# Local test photos for Photo Scout (tens of MB, Yunus's own)
samplerowtestingimagery/
# Crop test photos and their outputs (scripts/bench/cropTest.ts): imagery stays local.
CropTesting/

# The hero video master (50 MB 4K .mov). public/video/hero.* are the served derivatives.
herovideo/

# Annotation benchmarks: the photos and the rendered evidence stay out of the history; the labels, the manifests, the metrics and the report go in.
evaluation/**/*.JPG
evaluation/**/*.jpg
evaluation/**/results/*.png
evaluation/**/baseline/*.png

# The close-range measurement experiment: originals and rendered pictures stay out; results, reviews and the report go in.
measurementrealworldimages/rawimagery/
measurementrealworldimages/results/images/*.png
measurementrealworldimages/results/inspect/
measurementrealworldimages/results/contact-sheet.png
